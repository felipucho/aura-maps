{
  "expo": {
    "name": "lorenzo",
    "slug": "lorenzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lorenzo usa tu ubicación para centrar el mapa donde estás."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lorenzo necesita acceder a tu galería para elegir la foto de un lugar.",
          "cameraPermission": "Lorenzo necesita la cámara para sacar la foto de un lugar."
        }
      ],
      "expo-asset"
    ]
  }
}
